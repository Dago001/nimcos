# /etc/cron.d/nimcos — Laravel scheduler (election auto-open/close every minute,
# session expiry, hourly audit-chain verification) and nightly database backup.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * *  nimcos  cd /var/www/nimcos/current && php artisan schedule:run >> /dev/null 2>&1
15 1 * * * nimcos  /var/www/nimcos/current/scripts/backup.sh nightly >> /var/log/nimcos-backup.log 2>&1
