APP_NAME="NIMCOS E-VOTING"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
NIMCOS_DISPLAY_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nimcos
DB_USERNAME=nimcos
DB_PASSWORD=change-me
DB_TEST_DATABASE=nimcos_test

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# All voter codes and admin notices are sent by email. Use smtp in production:
# MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT=587, MAIL_USERNAME, MAIL_PASSWORD, MAIL_SCHEME=smtp
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nimcos.local"
MAIL_FROM_NAME="${APP_NAME}"


NIMCOS_DEMO_MODE=true
NIMCOS_REQUIRE_ADMIN_MFA=false

# ------------------------------------------------------------------
# PRODUCTION CHECKLIST (see docs/DEPLOYMENT.md)
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
#   SESSION_SECURE_COOKIE=true
#   NIMCOS_DEMO_MODE=false            (the app refuses to boot otherwise)
#   NIMCOS_REQUIRE_ADMIN_MFA=true
#   MAIL_MAILER=smtp + MAIL_HOST/PORT/USERNAME/PASSWORD (never "log")
#   MAIL_FROM_ADDRESS=<an address on the NIMCOS domain>
#   LOG_LEVEL=info
# ------------------------------------------------------------------
